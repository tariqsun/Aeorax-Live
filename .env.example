# Aeorax Live Environment Variables Template

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_local_dev_key_change_in_production

# PostgreSQL Database (aeorax_db)
DATABASE_URL="postgresql://aeorax_user:aeorax_pass@localhost:5432/aeorax_db?schema=public"

# Redis Cache & Quota Leases
REDIS_URL="redis://localhost:6379"

# Scalelite Load Balancer Integration
SCALELITE_API_URL="https://bbb.aeoraxlive.com/bigbluebutton/api"
SCALELITE_SHARED_SECRET="sample_scalelite_secret_replace_in_prod"

# Cloudflare R2 Recording Storage (S3 Compatible)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=aeorax-recordings
R2_PUBLIC_DOMAIN=recordings.aeoraxlive.com

# Evolution API WhatsApp Alerts (Optional)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=aeorax_alerts
EVOLUTION_ADMIN_PHONE=
